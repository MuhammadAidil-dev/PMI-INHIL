{
  "name": "pmi-backend",
  "version": "1.0.0",
  "description": "Backend API - Aplikasi Donor & Stok Darah PMI Kab. Indragiri Hilir",
  "main": "dist/server.js",
  "scripts": {
    "dev": "tsx watch --env-file=.env.dev src/server.ts",
    "start": "node --env-file=.env.prod dist/server.js",
    "build": "tsc && tsc-alias",
    "seed": "tsx --env-file=.env.dev src/scripts/seed.ts",
    "lint": "eslint src/**/*.ts",
    "seed:admin": "ts-node -r tsconfig-paths/register src/seeders/auth/auth.seeder.ts seed",
    "seed:admin:clear": "ts-node -r tsconfig-paths/register src/seeders/auth/auth.seeder.ts clear"
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "joi": "^17.13.3",
    "jsonwebtoken": "^9.0.2",
    "mongoose": "^8.4.0",
    "multer": "^2.1.1",
    "node-cron": "^4.2.1"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/cookie-parser": "^1.4.7",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.6",
    "@types/multer": "^2.1.0",
    "@types/node": "^20.14.2",
    "@types/node-cron": "^3.0.11",
    "ts-node": "^10.9.2",
    "tsc-alias": "^1.8.16",
    "tsconfig-paths": "^4.2.0",
    "tsx": "^4.15.2",
    "typescript": "^5.4.5"
  }
}
